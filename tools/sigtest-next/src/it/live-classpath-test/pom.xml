<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>jakarta.tck.it</groupId>
    <artifactId>live-classpath-test</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>IT: Live-classpath happy-path test</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- The plugin under test ships the SignatureAssert class -->
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>sigtest-next-plugin</artifactId>
            <version>@project.version@</version>
            <scope>test</scope>
        </dependency>

        <!-- JSON-B implementation needed to deserialize the baseline at test time -->
        <dependency>
            <groupId>org.eclipse.yasson</groupId>
            <artifactId>yasson</artifactId>
            <version>@jsonb.impl.version@</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 engine to run the test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>@junit.version@</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Step 1: generate the baseline into test-classes so SignatureAssert can find it -->
            <plugin>
                <groupId>jakarta.tck</groupId>
                <artifactId>sigtest-next-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <id>generate-sig</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <classes>${project.build.outputDirectory}</classes>
                            <packages>com.example.api</packages>
                            <sigfile>${project.build.directory}/greeting-api.sig.json</sigfile>
                            <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                            <apiVersion>1.0.0</apiVersion>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
